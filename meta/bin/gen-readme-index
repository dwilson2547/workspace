#!/usr/bin/env python3
"""gen-readme-index — rebuild the project index in the workspace README.

Walks the domain folders, matches every project against meta/project-index.toml
and rewrites the block between the project-index markers in README.md. Projects
on disk but not in the catalog are still listed, with their README's opening
line, and reported on stderr so they can be given a proper summary.

private/, archive/ and docs/ are never walked. Submodules link to their remote
repo (GitHub cannot browse a gitlink by relative path); private ones get a lock
and no link; plain folders link relatively.

Usage:
  gen-readme-index            rewrite README.md
  gen-readme-index --check    exit 1 if README.md is out of date (writes nothing)
"""
import argparse
import configparser
import os
import re
import sys
import tomllib

WS = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
CATALOG = os.path.join(WS, "meta", "project-index.toml")
README = os.path.join(WS, "README.md")
START = "<!-- project-index:start (generated by meta/bin/gen-readme-index; edit meta/project-index.toml) -->"
END = "<!-- project-index:end -->"
NEVER = {"private", "archive", "docs"}
# Plain folders whose children are the projects.
CONTAINERS = {"tools/obsidian-plugins", "experiments/testing"}
README_NAMES = ("README.md", "readme.md", "Readme.md", "README.rst", "README")


def submodules():
    """path -> https URL for every submodule in .gitmodules."""
    cp = configparser.ConfigParser()
    cp.read(os.path.join(WS, ".gitmodules"))
    out = {}
    for sec in cp.sections():
        path, url = cp[sec].get("path"), cp[sec].get("url", "")
        url = re.sub(r"^git@github\.com:", "https://github.com/", url)
        out[path] = re.sub(r"\.git$", "", url)
    return out


def opening_line(path):
    """First prose paragraph of a project's README, for uncatalogued projects."""
    for name in README_NAMES:
        f = os.path.join(WS, path, name)
        if os.path.isfile(f):
            text = re.sub(r"^---\n.*?\n---\n", "", open(f, errors="ignore").read(), flags=re.S)
            para = []
            for line in text.splitlines():
                s = line.strip()
                if not s or s.startswith(("#", "```", "|", "!", "<", ">", "---", "=")):
                    if para:
                        break
                    continue
                para.append(s)
            line = " ".join(para)
            return line[:157] + "…" if len(line) > 160 else line
    return ""


def discover(domains):
    for d in domains:
        root = os.path.join(WS, d)
        if not os.path.isdir(root):
            continue
        for e in sorted(os.listdir(root), key=str.lower):
            p = f"{d}/{e}"
            if e == "docs" or e.startswith(".") or not os.path.isdir(os.path.join(WS, p)):
                continue
            if p in CONTAINERS:
                for c in sorted(os.listdir(os.path.join(WS, p)), key=str.lower):
                    if os.path.isdir(os.path.join(WS, p, c)) and not c.startswith("."):
                        yield d, f"{p}/{c}"
            else:
                yield d, p


def cell(text):
    return text.replace("|", "\\|").replace("\n", " ")


def link(path, meta, subs):
    name = path.split("/")[-1]
    if meta.get("private"):
        return f"🔒 **{name}**"
    if path in subs:
        return f"[**{name}**]({subs[path]})"
    return f"[**{name}**]({path})"


def render(catalog, subs):
    domains = catalog["domains"]
    projects = catalog.get("projects", {})
    on_disk = os.listdir(WS)
    unknown_domains = sorted(
        d for d in on_disk
        if os.path.isdir(os.path.join(WS, d)) and not d.startswith(".")
        and d not in domains and d not in NEVER)
    for d in unknown_domains:
        print(f"warning: folder {d}/ is not a domain in {CATALOG}; skipped", file=sys.stderr)

    found, missing = {}, []
    for d, p in discover(domains):
        meta = projects.get(p, {})
        if meta.get("hidden"):
            continue
        if p not in projects:
            missing.append(p)
        found.setdefault(d, []).append((p, meta))
    for p in sorted(set(projects) - {p for ps in found.values() for p, _ in ps}):
        if not projects[p].get("hidden"):
            print(f"warning: {p} is in the catalog but not on disk", file=sys.stderr)
    for p in missing:
        print(f"warning: {p} has no catalog entry; using its README", file=sys.stderr)

    total = sum(len(v) for v in found.values())
    out = [START, ""]

    out += ["### Highlights", "", "| Project | What it is | Stack |", "|---|---|---|"]
    for d in domains:
        for p, meta in found.get(d, []):
            if meta.get("featured"):
                what = meta.get("summary", "")
                if meta.get("live"):
                    what += f" [Live ↗]({meta['live']})"
                out.append(f"| {link(p, meta, subs)} | {cell(what)} | {cell(meta.get('stack', ''))} |")
    out.append("")

    out += [f"### All projects ({total})", ""]
    out.append(" · ".join(f"[{domains[d]['title']}](#{anchor(domains[d]['title'])})"
                          for d in domains if d in found))
    out.append("")
    for d in domains:
        if d not in found:
            continue
        out += [f"#### {domains[d]['title']}", "", f"`{d}/` — {domains[d].get('blurb', '')}", "",
                "| Project | What it is |", "|---|---|"]
        for p, meta in found[d]:
            summary = meta.get("summary") or opening_line(p) or "—"
            out.append(f"| {link(p, meta, subs)} | {cell(summary)} |")
        out.append("")
    out.append(END)
    return "\n".join(out)


def anchor(title):
    """GitHub heading anchor."""
    a = re.sub(r"[^\w\- ]", "", title.lower()).strip().replace(" ", "-")
    return a


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--check", action="store_true")
    args = ap.parse_args()

    with open(CATALOG, "rb") as f:
        catalog = tomllib.load(f)
    block = render(catalog, submodules())

    text = open(README).read()
    pattern = re.compile(re.escape(START) + r".*?" + re.escape(END), re.S)
    if not pattern.search(text):
        sys.exit(f"error: markers not found in {README}")
    new = pattern.sub(lambda _: block, text)
    if args.check:
        sys.exit(0 if new == text else 1)
    if new != text:
        open(README, "w").write(new)
        print("README.md project index updated", file=sys.stderr)


if __name__ == "__main__":
    main()
