#!/usr/bin/env bash
# Bring the workspace up to date BEFORE work starts, and report what could not be
# handled automatically. Runs from a SessionStart hook.
#
# Why sync rather than report: an agent told "you are behind" has to remember to
# act on it, and doesn't. Worse, discovering staleness at commit time means the
# work is already done and paid for. So this fast-forwards what it safely can.
#
# Safety: fast-forward ONLY, and only when the working tree is clean and has no
# unpushed commits. A fast-forward on a clean tree cannot lose work. Anything
# else — dirty, diverged, detached with local commits, pinned to a tag — is left
# untouched and reported.
#
# Submodules track their BRANCH, not the superrepo's pinned commit. Git checks a
# submodule out detached, at the pin; this puts it back on its branch
# (.gitmodules `branch =`, else origin's default) whenever that loses nothing:
# clean tree, no commits of its own, and the pinned commit already on the branch.
# Superrepo pins drifting behind is accepted background noise.
#
# A submodule added to .gitmodules after this clone was made is never checked
# out by fetch, pull or `submodule foreach`. This initialises it, so a clone
# does not silently lack whole projects (and doc-indexer does not lack their docs).
#
# Output stays short: routine work is a count, only problems are named. A
# chattier version of this (a Stop hook) was removed for burying the real report.
#
# WSGIT_NO_PULL=1  fetch and report only, never move or clone anything.

set -uo pipefail
_self="$(readlink -f "${BASH_SOURCE[0]}")"
WS="${WSGIT_ROOT:-$(cd "$(dirname "$_self")/../.." && pwd)}"
FETCH_TIMEOUT="${WSGIT_FETCH_TIMEOUT:-15}"
JOBS="${WSGIT_JOBS:-16}"

cd "$WS" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

INIT_TIMEOUT="${WSGIT_INIT_TIMEOUT:-60}"

synced=(); attention=(); attached=0; detached_left=0

# --- fetch everything in parallel ------------------------------------------
timeout "$FETCH_TIMEOUT" git fetch --quiet origin >/dev/null 2>&1
sm_list=$(git config --file .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}')

# --- initialise submodules this clone has never checked out ----------------
# Only after the superrepo is current, so a just-pulled .gitmodules counts too.
init_new() {
    local sm
    printf '%s\n' "$sm_list" | while read -r sm; do
        [ -z "$sm" ] || [ -e "$WS/$sm/.git" ] && continue
        if [ -n "${WSGIT_NO_PULL:-}" ]; then
            echo "ATTN|$sm|not checked out on this machine (auto-init disabled). Needs: git submodule update --init $sm"
        elif timeout "$INIT_TIMEOUT" git -C "$WS" submodule update --init --recursive --quiet -- "$sm" >/dev/null 2>&1; then
            # Same guards as the rest of the workspace, if this clone uses them.
            # (install-git-guards.sh would do it, but only when someone re-runs it.)
            local hp
            hp=$(git -C "$WS" config --local --get core.hooksPath 2>/dev/null)
            [ -n "$hp" ] && git -C "$WS/$sm" config --local core.hooksPath "$hp"
            echo "SYNCED|$sm|newly added submodule, cloned"
        else
            echo "ATTN|$sm|not checked out on this machine and clone failed or timed out. Needs: git submodule update --init $sm"
        fi
    done
}

# The branch a submodule tracks: .gitmodules `branch =`, else origin's default.
tracking_branch() {
    local path="$1" name b
    name=$(git config -f "$WS/.gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null \
           | awk -v p="$path" '$2 == p { sub(/^submodule\./, "", $1); sub(/\.path$/, "", $1); print $1; exit }')
    [ -n "$name" ] && b=$(git config -f "$WS/.gitmodules" "submodule.$name.branch" 2>/dev/null)
    [ -z "${b:-}" ] && b=$(git -C "$WS/$path" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    printf '%s' "${b:-}"
}
printf '%s\n' "$sm_list" | while read -r sm; do
    [ -n "$sm" ] && [ -e "$WS/$sm/.git" ] && printf '%s\0' "$sm"
done | xargs -0 -P "$JOBS" -I{} sh -c \
    "timeout $FETCH_TIMEOUT git -C '$WS/{}' fetch --quiet origin >/dev/null 2>&1" 2>/dev/null

# --- put a detached submodule back on its branch ---------------------------
# echoes: "ATTACHED <label>" | "DETACHED <label>" (left, routine) | "ATTN ..."
attach_branch() {
    local dir="$1" label="$2" b
    b=$(tracking_branch "$label")
    if [ -z "$b" ] || ! git -C "$dir" rev-parse -q --verify "refs/remotes/origin/$b" >/dev/null; then
        echo "ATTN|$label|detached, and no origin branch to track (set branch = in .gitmodules)"
        return
    fi
    if ! git -C "$dir" diff --quiet 2>/dev/null || ! git -C "$dir" diff --cached --quiet 2>/dev/null; then
        echo "ATTN|$label|detached with uncommitted changes — left as is. Needs: git checkout $b (carrying the changes)"
        return
    fi
    if ! git -C "$dir" merge-base --is-ancestor HEAD "origin/$b" 2>/dev/null; then
        echo "ATTN|$label|detached at a commit that is not on origin/$b — left as is"
        return
    fi
    # A local branch with commits of its own would be reset by -B below: leave it.
    if git -C "$dir" rev-parse -q --verify "refs/heads/$b" >/dev/null \
       && ! git -C "$dir" merge-base --is-ancestor "refs/heads/$b" "origin/$b" 2>/dev/null; then
        echo "ATTN|$label|detached, and local '$b' has commits not on origin/$b — left as is"
        return
    fi
    if [ -n "${WSGIT_NO_PULL:-}" ]; then
        echo "DETACHED|$label|"
        return
    fi
    if git -C "$dir" checkout -q -B "$b" "origin/$b" 2>/dev/null \
       && git -C "$dir" branch -q --set-upstream-to="origin/$b" "$b" 2>/dev/null; then
        echo "ATTACHED|$label|"
    else
        echo "ATTN|$label|detached; checking out $b failed (an untracked file in the way?)"
    fi
}

# --- sync one repo ---------------------------------------------------------
# echoes: "SYNCED <label> <detail>" | "ATTN <label> <detail>" | nothing
sync_repo() {
    local dir="$1" label="$2" branch up behind ahead dirty

    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
    local unpushed
    unpushed=$(git -C "$dir" rev-list --count HEAD --not --remotes 2>/dev/null || echo 0)

    if [ "$branch" = "HEAD" ]; then
        if [ "${unpushed:-0}" -gt 0 ]; then
            echo "ATTN|$label|detached HEAD holding $unpushed commit(s) on no branch — create a branch for them (they will be lost otherwise)"
            return
        fi
        [ "$label" = workspace ] && { echo "ATTN|$label|superrepo HEAD is detached"; return; }
        attach_branch "$dir" "$label"
        return
    fi

    up=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
    if [ -z "$up" ]; then
        echo "ATTN|$label|branch '$branch' has no upstream — nothing verifies it is current"
        return
    fi

    read -r behind ahead < <(git -C "$dir" rev-list --left-right --count "$up...HEAD" 2>/dev/null)
    behind=${behind:-0}; ahead=${ahead:-0}
    [ "$behind" = 0 ] && [ "$ahead" = 0 ] && return

    dirty=0
    git -C "$dir" diff --quiet 2>/dev/null || dirty=1
    git -C "$dir" diff --cached --quiet 2>/dev/null || dirty=1

    if [ "$behind" != 0 ] && [ "$ahead" != 0 ]; then
        echo "ATTN|$label|DIVERGED — $behind behind, $ahead ahead of $up. Needs: git pull --rebase"
        return
    fi
    if [ "$behind" != 0 ]; then
        if [ "$dirty" = 1 ]; then
            echo "ATTN|$label|$behind BEHIND $up but working tree is dirty. Needs: git stash && git pull --rebase && git stash pop"
        elif [ -n "${WSGIT_NO_PULL:-}" ]; then
            echo "ATTN|$label|$behind BEHIND $up (auto-pull disabled)"
        elif git -C "$dir" merge --ff-only "$up" >/dev/null 2>&1; then
            echo "SYNCED|$label|fast-forwarded $behind commit(s) to $up"
        else
            echo "ATTN|$label|$behind BEHIND $up and fast-forward failed. Needs: git pull --rebase"
        fi
        return
    fi
    echo "ATTN|$label|$ahead unpushed commit(s) — not on your other machine"
}

# The superrepo first: a pull can add submodules, which init_new then picks up.
results=$( sync_repo "$WS" "workspace"
           sm_list=$(git config --file .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}')
           init_new
           printf '%s\n' "$sm_list" | while read -r sm; do
               [ -n "$sm" ] && [ -e "$WS/$sm/.git" ] && sync_repo "$WS/$sm" "$sm"
           done )

while IFS='|' read -r kind label detail; do
    [ -z "$kind" ] && continue
    [ "$kind" = SYNCED   ] && synced+=("  $label: $detail")
    [ "$kind" = ATTN     ] && attention+=("  $label: $detail")
    [ "$kind" = ATTACHED ] && attached=$((attached + 1))
    [ "$kind" = DETACHED ] && detached_left=$((detached_left + 1))
done <<< "$results"
[ "$attached" -gt 0 ] && synced+=("  $attached detached submodule(s) put back on their branch at origin's tip")
[ "$detached_left" -gt 0 ] && synced+=("  $detached_left submodule(s) detached; would be put on their branch (auto-pull disabled)")
sm_count=$(printf '%s\n' "$sm_list" | grep -c .)

# --- emit ------------------------------------------------------------------
if [ ${#synced[@]} -eq 0 ] && [ ${#attention[@]} -eq 0 ]; then
    body="git: workspace and all $sm_count submodules are on their branches and in sync with their remotes."
else
    body="git state at session start — everything fetched, and safe fast-forwards already applied."
    if [ ${#synced[@]} -gt 0 ]; then
        body="$body

Brought up to date automatically (fast-forward, no work at risk):
$(printf '%s\n' "${synced[@]}")"
    fi
    if [ ${#attention[@]} -gt 0 ]; then
        body="$body

NOT handled automatically — resolve these BEFORE editing the files involved,
not at commit time:
$(printf '%s\n' "${attention[@]}")"
    fi
fi

if command -v jq >/dev/null 2>&1; then
    jq -n --arg b "$body" '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$b},suppressOutput:true}'
else
    printf '%s\n' "$body"
fi
exit 0
