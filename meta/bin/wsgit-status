#!/usr/bin/env bash
# Bring the workspace up to date BEFORE work starts, and report what could not be
# handled automatically. Runs from a SessionStart hook.
#
# Why sync rather than report: an agent told "you are behind" has to remember to
# act on it, and doesn't. Worse, discovering staleness at commit time means the
# work is already done and paid for. So this fast-forwards what it safely can.
#
# Safety: fast-forward ONLY, and only when the working tree is clean and has no
# unpushed commits. A fast-forward on a clean tree cannot lose work. Anything
# else — dirty, diverged, detached with local commits, pinned to a tag — is left
# untouched and reported.
#
# WSGIT_NO_PULL=1  fetch and report only, never move anything.

set -uo pipefail
_self="$(readlink -f "${BASH_SOURCE[0]}")"
WS="${WSGIT_ROOT:-$(cd "$(dirname "$_self")/../.." && pwd)}"
FETCH_TIMEOUT="${WSGIT_FETCH_TIMEOUT:-15}"
JOBS="${WSGIT_JOBS:-16}"

cd "$WS" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

synced=(); attention=()

# --- fetch everything in parallel ------------------------------------------
timeout "$FETCH_TIMEOUT" git fetch --quiet origin >/dev/null 2>&1
sm_list=$(git config --file .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}')
printf '%s\n' "$sm_list" | while read -r sm; do
    [ -n "$sm" ] && [ -e "$WS/$sm/.git" ] && printf '%s\0' "$sm"
done | xargs -0 -P "$JOBS" -I{} sh -c \
    "timeout $FETCH_TIMEOUT git -C '$WS/{}' fetch --quiet origin >/dev/null 2>&1" 2>/dev/null

# --- sync one repo ---------------------------------------------------------
# echoes: "SYNCED <label> <detail>" | "ATTN <label> <detail>" | nothing
sync_repo() {
    local dir="$1" label="$2" branch up behind ahead dirty

    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
    local unpushed
    unpushed=$(git -C "$dir" rev-list --count HEAD --not --remotes 2>/dev/null || echo 0)

    if [ "$branch" = "HEAD" ]; then
        # Detached. Normal for a pinned submodule; only a problem if it holds work.
        [ "${unpushed:-0}" -gt 0 ] && echo "ATTN|$label|detached HEAD holding $unpushed commit(s) on no branch — git checkout main (they will be lost otherwise)"
        return
    fi

    up=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
    if [ -z "$up" ]; then
        echo "ATTN|$label|branch '$branch' has no upstream — nothing verifies it is current"
        return
    fi

    read -r behind ahead < <(git -C "$dir" rev-list --left-right --count "$up...HEAD" 2>/dev/null)
    behind=${behind:-0}; ahead=${ahead:-0}
    [ "$behind" = 0 ] && [ "$ahead" = 0 ] && return

    dirty=0
    git -C "$dir" diff --quiet 2>/dev/null || dirty=1
    git -C "$dir" diff --cached --quiet 2>/dev/null || dirty=1

    if [ "$behind" != 0 ] && [ "$ahead" != 0 ]; then
        echo "ATTN|$label|DIVERGED — $behind behind, $ahead ahead of $up. Needs: git pull --rebase"
        return
    fi
    if [ "$behind" != 0 ]; then
        if [ "$dirty" = 1 ]; then
            echo "ATTN|$label|$behind BEHIND $up but working tree is dirty. Needs: git stash && git pull --rebase && git stash pop"
        elif [ -n "${WSGIT_NO_PULL:-}" ]; then
            echo "ATTN|$label|$behind BEHIND $up (auto-pull disabled)"
        elif git -C "$dir" merge --ff-only "$up" >/dev/null 2>&1; then
            echo "SYNCED|$label|fast-forwarded $behind commit(s) to $up"
        else
            echo "ATTN|$label|$behind BEHIND $up and fast-forward failed. Needs: git pull --rebase"
        fi
        return
    fi
    echo "ATTN|$label|$ahead unpushed commit(s) — not on your other machine"
}

results=$( sync_repo "$WS" "workspace"
           printf '%s\n' "$sm_list" | while read -r sm; do
               [ -n "$sm" ] && [ -e "$WS/$sm/.git" ] && sync_repo "$WS/$sm" "$sm"
           done )

while IFS='|' read -r kind label detail; do
    [ -z "$kind" ] && continue
    [ "$kind" = SYNCED ] && synced+=("  $label: $detail")
    [ "$kind" = ATTN   ] && attention+=("  $label: $detail")
done <<< "$results"

# --- emit ------------------------------------------------------------------
if [ ${#synced[@]} -eq 0 ] && [ ${#attention[@]} -eq 0 ]; then
    body="git: workspace and all 86 submodules are in sync with their remotes. Nothing to pull."
else
    body="git state at session start — everything fetched, and safe fast-forwards already applied."
    if [ ${#synced[@]} -gt 0 ]; then
        body="$body

Brought up to date automatically (fast-forward, no work at risk):
$(printf '%s\n' "${synced[@]}")"
    fi
    if [ ${#attention[@]} -gt 0 ]; then
        body="$body

NOT handled automatically — resolve these BEFORE editing the files involved,
not at commit time:
$(printf '%s\n' "${attention[@]}")"
    fi
fi

if command -v jq >/dev/null 2>&1; then
    jq -n --arg b "$body" '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$b},suppressOutput:true}'
else
    printf '%s\n' "$body"
fi
exit 0
